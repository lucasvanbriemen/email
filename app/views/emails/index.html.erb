<% content_for :title, "Mail" %>

<div class="pagination">
  <%= paginate @emails %>
</div>

<div class="email-page" data-controller="email-page">
  <div class="email-listing">
    <% @emails.each do |email| %>
      <button class="email-item" data-action="email-page#select" data-email-page-id-param="<%= email.id %>">
        <img src="<%= email.sender.image_url %>" loading="lazy">
        <%= email.sender.name %>
        <p><strong>Subject:</strong> <%= email.subject %></p>
        <%= time_ago_in_words_with_tooltip(email.created_at) %>
      </button>
    <% end %>
  </div>

  <div class="email-content" data-email-page-target="content">
    <p>Select an email to view its content.</p>
  </div>
</div>
