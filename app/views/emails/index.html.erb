<% content_for :title, "Email" %>

<div class="pagination">
  <%= paginate @emails %>
</div>

<div class="container">
  <%= @emails.each do |email| %>
    <div class="box">
      <%= email.sender.name %>
      <p><strong>To:</strong> <%= email.to %></p>
      <p><strong>Subject:</strong> <%= email.subject %></p>
    </div>
  <% end %>
</div>

