<div class="email-header">
  <img src="<%= email.sender.image_url %>" class="sender-image" loading="lazy">
  <div class="email-info">
    <h3 class="sender-name"><%= email.subject %></h3>
    <div class="meta">
      <span class="sender"><%= email.sender.name %></span>
      <span class="separator"></span>
      <span class="sender-email"><%= email.sender.email %></span>
      <span class="separator"></span>
      <span class="timestamp"><%= time_ago_in_words(email.created_at) %></span>
    </div>

    <p class="to">to: <%= email.to %></p>
  </div>
</div>

<iframe srcdoc="<%= email.html_body %>" sandbox='allow-scripts allow-top-navigation allow-forms'></iframe>