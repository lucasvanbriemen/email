-square h-full w-full bg-background object-cover" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fimg.logo.dev%2Flouisvuitton.com%3Ftoken%3Dlive_6a1a28fd-6420-4492-aeb0-b297461d9de2%26size%3D48%26retina%3Dtrue%26format%3Dwebp&amp;w=48&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fimg.logo.dev%2Flouisvuitton.com%3Ftoken%3Dlive_6a1a28fd-6420-4492-aeb0-b297461d9de2%26size%3D48%26retina%3Dtrue%26format%3Dwebp&amp;w=96&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fimg.logo.dev%2Flouisvuitton.com%3Ftoken%3Dlive_6a1a28fd-6420-4492-aeb0-b297461d9de2%26size%3D48%26retina%3Dtrue%26format%3Dwebp&amp;w=96&amp;q=75"/></span></div></li><li class="ticker-item" aria-hidden="false" aria-posinset="50" aria-setsize="50" style="flex-grow:0;flex-shrink:0;position:relative;height:fit-content;transform:none"><div class="mx-2 shrink-0"><span data-slot="avatar" class="border-overlay relative flex shrink-0 overflow-hidden rounded-sm h-12 w-12"><img alt="lululemon.com" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="aspect-square h-full w-full bg-background object-cover" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fimg.logo.dev%2Flululemon.com%3Ftoken%3Dlive_6a1a28fd-6420-4492-aeb0-b297461d9de2%26size%3D48%26retina%3Dtrue%26format%3Dwebp&amp;w=48&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fimg.logo.dev%2Flululemon.com%3Ftoken%3Dlive_6a1a28fd-6420-4492-aeb0-b297461d9de2%26size%3D48%26retina%3Dtrue%26format%3Dwebp&amp;w=96&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fimg.logo.dev%2Flululemon.com%3Ftoken%3Dlive_6a1a28fd-6420-4492-aeb0-b297461d9de2%26size%3D48%26retina%3Dtrue%26format%3Dwebp&amp;w=96&amp;q=75"/></span></div></li></ul></div> </div></div><section class="container mx-auto max-w-4xl" id="demo"><section class="my-36 rounded-lg bg-secondary/50 px-6 py-12"><header class="text-center"><h2 class="mb-2 text-balance font-medium text-xl leading-[1.1] tracking-tight md:text-2xl">Test it live in a few seconds</h2><p class="mb-6 text-pretty text-base text-muted-foreground leading-7">Enter any company name below. Watch how fast we find their logo.</p></header><div class="mx-auto mt-4 max-w-md"><div class=""><div class="rounded-lg border bg-card text-card-foreground shadow-xs"><div class="p-6"><div class="mb-6 flex gap-4"><div class="h-16 w-16 shrink-0 overflow-hidden rounded-lg rounded-sm" style="opacity:0;transform:scale(0.8)"><span data-slot="avatar" class="border-overlay relative flex shrink-0 overflow-hidden rounded-sm h-full w-full"><img alt="logo.dev" loading="lazy" width="64" height="64" decoding="async" data-nimg="1" class="aspect-square h-full w-full bg-background object-cover" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fimg.logo.dev%2Flogo.dev%3Ftoken%3Dlive_6a1a28fd-6420-4492-aeb0-b297461d9de2%26size%3D64%26retina%3Dtrue%26format%3Dwebp&amp;w=64&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fimg.logo.dev%2Flogo.dev%3Ftoken%3Dlive_6a1a28fd-6420-4492-aeb0-b297461d9de2%26size%3D64%26retina%3Dtrue%26format%3Dwebp&amp;w=128&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fimg.logo.dev%2Flogo.dev%3Ftoken%3Dlive_6a1a28fd-6420-4492-aeb0-b297461d9de2%26size%3D64%26retina%3Dtrue%26format%3Dwebp&amp;w=128&amp;q=75"/></span></div><div class="flex flex-col justify-center"><h3 class="mb-0 line-clamp-1 overflow-hidden text-ellipsis font-semibold text-xl" style="opacity:0;transform:translateY(10px)">logo.dev</h3></div></div><div class="space-y-3"><div class="flex items-baseline gap-4"><span class="line-clamp-1 min-w-24 overflow-hidden text-ellipsis font-medium text-muted-foreground text-xs">URL</span><div class="flex-1 border-muted-foreground/30 border-b border-dotted"></div><span class="line-clamp-1 overflow-hidden text-ellipsis font-mono text-xs">https://img.logo.dev/logo.dev</span></div><div class="flex items-baseline gap-4"><span class="line-clamp-1 min-w-24 overflow-hidden text-ellipsis font-medium text-muted-foreground text-xs">Format</span><div class="flex-1 border-muted-foreground/30 border-b border-dotted"></div><span class="line-clamp-1 overflow-hidden text-ellipsis font-mono text-xs">webp</span></div><div class="flex items-baseline gap-4"><span class="line-clamp-1 min-w-24 overflow-hidden text-ellipsis font-medium text-muted-foreground text-xs">Size</span><div class="flex-1 border-muted-foreground/30 border-b border-dotted"></div><span class="line-clamp-1 overflow-hidden text-ellipsis font-mono text-xs">128</span></div><div class="flex items-baseline gap-4"><span class="line-clamp-1 min-w-24 overflow-hidden text-ellipsis font-medium text-muted-foreground text-xs">Fallback</span><div class="flex-1 border-muted-foreground/30 border-b border-dotted"></div><span class="line-clamp-1 overflow-hidden text-ellipsis font-mono text-xs">monogram</span></div><div class="flex items-baseline gap-4"><span class="line-clamp-1 min-w-24 overflow-hidden text-ellipsis font-medium text-muted-foreground text-xs">Retina</span><div class="flex-1 border-muted-foreground/30 border-b border-dotted"></div><span class="line-clamp-1 overflow-hidden text-ellipsis font-mono text-xs">true</span></div></div></div></div><div class="mt-6"><div class="relative"><form class="flex gap-2"><div class="flex-1"><div tabindex="-1" class="flex h-full w-full flex-col rounded-md bg-popover text-popover-foreground overflow-visible" cmdk-root=""><label cmdk-label="" for="radix-_R_1d35bqivanbH2_" id="radix-_R_1d35bqivanbH1_" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;border-width:0"></label><div class="flex h-10 w-full items-center rounded-md border border-input bg-background text-sm ring-offset-background focus-within:ring-2 focus-within:ring-ring focus-within:ring-offset-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search ml-3 h-4 w-4 shrink-0 opacity-50" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><div class="flex-1 [&amp;_[cmdk-input-wrapper]_svg]:hidden"><div class="flex items-center px-3" cmdk-input-wrapper=""><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search mr-2 h-4 w-4 shrink-0 opacity-50" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><input class="outline-hidden flex h-10 w-full rounded-md bg-transparent py-3 text-sm placeholder:text-muted-foreground focus:outline-hidden disabled:cursor-not-allowed disabled:opacity-50" placeholder="Enter a brand name or domain" cmdk-input="" autoComplete="off" autoCorrect="off" spellCheck="false" aria-autocomplete="list" role="combobox" aria-expanded="true" aria-controls="radix-_R_1d35bqivanb_" aria-labelledby="radix-_R_1d35bqivanbH1_" id="radix-_R_1d35bqivanbH2_" type="text" value=""/></div></div></div></div></div><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium text-sm ring-offset-background transition-all duration-150 ease-in-out disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 relative rounded-md border border-transparent bg-linear-to-b bg-primary from-[#2c2c30] to-[#1d1d20] text-primary-foreground shadow-inner before:pointer-events-none before:absolute before:inset-0 before:rounded-md before:shadow-[0px_2px_0.4px_0px_rgba(255,255,255,0.16)_inset] hover:bg-[#1f1f1f] hover:opacity-90 hover:shadow-none focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-neutral-900 focus-visible:ring-offset-1 dark:bg-linear-to-b dark:from-white dark:to-neutral-100 dark:text-primary-foreground dark:hover:bg-white size-10 shrink-0" type="submit"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up h-4 w-4" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></form></div><div class="mt-4 space-y-4"><div class="flex flex-wrap items-center justify-center gap-2 px-6"></div><div class="flex justify-center"><button class="inline-flex items-center justify-center whitespace-nowrap font-medium ring-offset-background transition-all duration-150 ease-in-out focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 hover:bg-accent hover:text-accent-foreground h-9 px-3 gap-2 rounded-full text-xs"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shuffle h-3 w-3" aria-hidden="true"><path d="m18 14 4 4-4 4"></path><path d="m18 2 4 4-4 4"></path><path d="M2 18h1.973a4 4 0 0 0 3.3-1.7l5.454-8.6a4 4 0 0 1 3.3-1.7H22"></path><path d="M2 6h1.972a4 4 0 0 1 3.6 2.2"></path><path d="M22 18h-6.041a4 4 0 0 1-3.3-1.8l-.359-.45"></path></svg>Shuffle</button></div></div></div></div></div></section><section class="my-24"><header class="text-center"><h2 class="mb-2 text-balance font-medium text-xl leading-[1.1] tracking-tight md:text-2xl">Don&#x27;t take our word for it</h2><p class="mb-6 text-pretty text-base text-muted-foreground leading-7">Here&#x27;s why developers choose Logo.dev for company logos</p></header><div class="mx-auto mt-12 columns-1 gap-4 sm:columns-2 lg:columns-3"><div class="mb-4"><article class="break-inside-avoid rounded-xl border border-border bg-card p-5"><header class="flex items-start gap-3"><span data-slot="avatar" class="relative flex size-8 overflow-hidden rounded-full h-11 w-11 shrink-0"><span data-slot="avatar-fallback" class="flex size-full items-center justify-center rounded-full bg-muted text-muted-foreground text-sm font-medium">AK</span></span><div class="min-w-0 flex-1"><span class="block truncate font-semibold text-foreground">Andy Keil</span><span class="block text-sm text-muted-foreground">@<!-- -->andykeil</span></div></header><p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-foreground">We&#x27;ve been using Logo.dev for a few months and have been loving it. WAY better to add logos for our company avatars instead of the tacky initials you see everywhere. It was so easy to add.</p></article></div><div class="mb-4"><article class="break-inside-avoid rounded-xl border border-border bg-card p-5"><header class="flex items-start gap-3"><span data-slot="avatar" class="relative flex size-8 overflow-hidden rounded-full h-11 w-11 shrink-0"><span data-slot="avatar-fallback" class="flex size-full items-center justify-center rounded-full bg-muted text-muted-foreground text-sm font-medium">SL</span></span><div class="min-w-0 flex-1"><span class="block truncate font-semibold text-foreground">SUKUI LIU</span><span class="block text-sm text-muted-foreground">@<!-- -->sukuiliu</span></div></header><p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-foreground">Honestly, I used Clearbit extensively when developing my own products, and when their logo API got shut down, it was genuinely frustrating—it really disrupts a developer&#x27;s workflow when a foundational service suddenly disappears. Super glad to see you stepping up! Your API design is very intuitive, and the loading speed is excellent. Keep up the great work, looking forward to your future updates!</p></article></div><div class="mb-4"><article class="break-inside-avoid rounded-xl border border-border bg-card p-5"><header class="flex items-start gap-3"><span data-slot="avatar" class="relative flex size-8 overflow-hidden rounded-full h-11 w-11 shrink-0"><span data-slot="avatar-fallback" class="flex size-full items-center justify-center rounded-full bg-muted text-muted-foreground text-sm font-medium">KL</span></span><div class="min-w-0 flex-1"><span class="block truncate font-semibold text-foreground">Kyle Ledbetter</span><span class="block text-sm text-muted-foreground">@<!-- -->kyleledbetter</span></div></header><p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-foreground">Super easy developer experience, straightforward APIs, and nice to have options to use as inline html img tag. 

Lots of features too, like dark mode and theme support, retina, size, grayscale.

Also the team is great with feedback and feature requests.</p></article></div><div class="mb-4"><article class="break-inside-avoid rounded-xl border border-border bg-card p-5"><header class="flex items-start gap-3"><span data-slot="avatar" class="relative flex size-8 overflow-hidden rounded-full h-11 w-11 shrink-0"><span data-slot="avatar-fallback" class="flex size-full items-center justify-center rounded-full bg-muted text-muted-foreground text-sm font-medium">RH</span></span><div class="min-w-0 flex-1"><span class="block truncate font-semibold text-foreground">Ryan Hoover</span><span class="block text-sm text-muted-foreground">@<!-- -->ryanhoover</span></div></header><p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-foreground">Oooo, this could be useful for something we&#x27;re building :)</p></article></div><div class="mb-4"><article class="break-inside-avoid rounded-xl border border-border bg-card p-5"><header class="flex items-start gap-3"><span data-slot="avatar" class="relative flex size-8 overflow-hidden rounded-full h-11 w-11 shrink-0"><span data-slot="avatar-fallback" class="flex size-full items-center justify-center rounded-full bg-muted text-muted-foreground text-sm font-medium">S</span></span><div class="min-w-0 flex-1"><span class="block truncate font-semibold text-foreground">Santhiaroo</span><span class="block text-sm text-muted-foreground">@<!-- -->santhiaroo</span></div></header><p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-foreground">I have been experimenting with Logo.dev and even integrated it into my new product. The sign-up process is a magical experience that users love when they test my app. The free plan alone is more than sufficient. I&#x27;ve now made it a rule to integrate Logo.dev into all my apps.</p></article></div><div class="mb-4"><article class="break-inside-avoid rounded-xl border border-border bg-card p-5"><header class="flex items-start gap-3"><span data-slot="avatar" class="relative flex size-8 overflow-hidden rounded-full h-11 w-11 shrink-0"><span data-slot="avatar-fallback" class="flex size-full items-center justify-center rounded-full bg-muted text-muted-foreground text-sm font-medium">SK</span></span><div class="min-w-0 flex-1"><span class="block truncate font-semibold text-foreground">Steven Kovar</span><span class="block text-sm text-muted-foreground">@<!-- -->stevenkovar</span></div></header><p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-foreground">It just works. I was going to build this app for myself and Logo.dev works so well I almost forgot I was using it. What a luxury to not have to download and edit logos anymore.</p></article></div><div class="mb-4"><article class="break-inside-avoid rounded-xl border border-border bg-card p-5"><header class="flex items-start gap-3"><span data-slot="avatar" class="relative flex size-8 overflow-hidden rounded-full h-11 w-11 shrink-0"><span data-slot="avatar-fallback" class="flex size-full items-center justify-center rounded-full bg-muted text-muted-foreground text-sm font-medium">KB</span></span><div class="min-w-0 flex-1"><span class="block truncate font-semibold text-foreground">Keith Brisson</span><span class="block text-sm text-muted-foreground">@<!-- -->keithbrisson</span></div></header><p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-foreground">Excellent replacement for the Clearbit logo API and migrating took 15 minutes.</p></article></div><div class="mb-4"><article class="break-inside-avoid rounded-xl border border-border bg-card p-5"><header class="flex items-start gap-3"><span data-slot="avatar" class="relative flex size-8 overflow-hidden rounded-full h-11 w-11 shrink-0"><span data-slot="avatar-fallback" class="flex size-full items-center justify-center rounded-full bg-muted text-muted-foreground text-sm font-medium">MA</span></span><div class="min-w-0 flex-1"><span class="block truncate font-semibold text-foreground">Moe Amaya</span><span class="block text-sm text-muted-foreground">@<!-- -->moeamaya</span></div></header><p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-foreground">Really big fan at Operate. When you released the dark mode prop, it eliminated an entire project from our roadmap!</p></article></div><div class="mb-4"><article class="break-inside-avoid rounded-xl border border-border bg-card p-5"><header class="flex items-start gap-3"><span data-slot="avatar" class="relative flex size-8 overflow-hidden rounded-full h-11 w-11 shrink-0"><span data-slot="avatar-fallback" class="flex size-full items-center justify-center rounded-full bg-muted text-muted-foreground text-sm font-medium">PF</span></span><div class="min-w-0 flex-1"><span class="block truncate font-semibold text-foreground">Phil Freo</span><span class="block text-sm text-muted-foreground">@<!-- -->philfreo</span></div></header><p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-foreground">We&#x27;ve been using Logo.dev for over a year now to power company logos in Close CRM and it&#x27;s been great. Simple, high quality, works well.</p></article></div><div class="mb-4"><article class="break-inside-avoid rounded-xl border border-border bg-card p-5"><header class="flex items-start gap-3"><span data-slot="avatar" class="relative flex size-8 overflow-hidden rounded-full h-11 w-11 shrink-0"><span data-slot="avatar-fallback" class="flex size-full items-center justify-center rounded-full bg-muted text-muted-foreground text-sm font-medium">PJ</span></span><div class="min-w-0 flex-1"><span class="block truncate font-semibold text-foreground">Philip Johnson</span><span class="block text-sm text-muted-foreground">@<!-- -->philipjohnson</span></div></header><p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-foreground">Logo.dev is easily the best solution out there with a killer team to boot. If you&#x27;re looking for an alternative look no further.</p></article></div><div class="mb-4"><article class="break-inside-avoid rounded-xl border border-border bg-card p-5"><header class="flex items-start gap-3"><span data-slot="avatar" class="relative flex size-8 overflow-hidden rounded-full h-11 w-11 shrink-0"><span data-slot="avatar-fallback" class="flex size-full items-center justify-center rounded-full bg-muted text-muted-foreground text-sm font-medium">DG</span></span><div class="min-w-0 flex-1"><span class="block truncate font-semibold text-foreground">Dan G</span><span class="block text-sm text-muted-foreground">@<!-- -->dang</span></div></header><p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-foreground">We’ve been using Logo.dev for probably a year at ShiftControl! It’s a simple to use service that just works. I also like their logo and company search, which is easy to embed into your own site. Retina logos, png/jpg, various sizes and even some other useful options like fallback to initials of the company name.  If you need company logos on your site, this is the way.</p></article></div><div class="mb-4"><article class="break-inside-avoid rounded-xl border border-border bg-card p-5"><header class="flex items-start gap-3"><span data-slot="avatar" class="relative flex size-8 overflow-hidden rounded-full h-11 w-11 shrink-0"><span data-slot="avatar-fallback" class="flex size-full items-center justify-center rounded-full bg-muted text-muted-foreground text-sm font-medium">RW</span></span><div class="min-w-0 flex-1"><span class="block truncate font-semibold text-foreground">Richard Westermann</span><span class="block text-sm text-muted-foreground">@<!-- -->richardwesterma</span></div></header><p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-foreground">Great product &amp; very easy to set up (the developer experience was simple!). I used this across Web, Android/iOS applications and Chrome Extension in my stack with zero issues. Truly one of the best logo platforms out there.</p></article></div></div></section><section class="my-24"><header class="text-center"><h2 class="mb-2 text-balance font-medium text-xl leading-[1.1] tracking-tight md:text-2xl">Real use cases we solve</h2><p class="mb-6 text-pretty text-base text-muted-foreground leading-7">Here&#x27;s exactly what you can do with our APIs.</p></header><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><div class="-mx-6 grid gap-4 md:grid-cols-2"><div class="rounded-lg p-6"><div class="h-[240px] w-full animate-pulse rounded-md bg-muted"></div><div class="mt-6 h-6 w-1/3 animate-pulse rounded bg-muted"></div><div class="mt-3 h-4 w-2/3 animate-pulse rounded bg-muted"></div></div><div class="rounded-lg p-6"><div class="h-[240px] w-full animate-pulse rounded-md bg-muted"></div><div class="mt-6 h-6 w-1/3 animate-pulse rounded bg-muted"></div><div class="mt-3 h-4 w-2/3 animate-pulse rounded bg-muted"></div></div><div class="rounded-lg p-6"><div class="h-[240px] w-full animate-pulse rounded-md bg-muted"></div><div class="mt-6 h-6 w-1/3 animate-pulse rounded bg-muted"></div><div class="mt-3 h-4 w-2/3 animate-pulse rounded bg-muted"></div></div><div class="rounded-lg p-6"><div class="h-[240px] w-full animate-pulse rounded-md bg-muted"></div><div class="mt-6 h-6 w-1/3 animate-pulse rounded bg-muted"></div><div class="mt-3 h-4 w-2/3 animate-pulse rounded bg-muted"></div></div></div><!--/$--></section><section class="my-36"><dl class="grid grid-cols-2 gap-6 sm:grid-cols-2 lg:grid-cols-4"><div class="rounded-lg bg-secondary/50 p-6"><dd class="line-clamp-1 font-medium font-mono text-2xl tracking-tight md:text-2xl">30M+</dd><dt class="text-base">Daily requests</dt></div><div class="rounded-lg bg-secondary/50 p-6"><dd class="line-clamp-1 font-medium font-mono text-2xl tracking-tight md:text-2xl">50M+</dd><dt class="text-base">Companies</dt></div><div class="rounded-lg bg-secondary/50 p-6"><dd class="line-clamp-1 font-medium font-mono text-2xl tracking-tight md:text-2xl">52M</dd><dt class="text-base">Brand assets</dt></div><div class="rounded-lg bg-secondary/50 p-6"><dd class="line-clamp-1 font-medium font-mono text-2xl tracking-tight md:text-2xl">628M</dd><dt class="text-base">Domains</dt></div></dl></section><section class="my-36"><div class=""><header class="text-center"><h2 class="mb-2 text-balance font-medium text-xl leading-[1.1] tracking-tight md:text-2xl">Ready to never think about logos again?</h2><p class="mb-6 text-pretty text-base text-muted-foreground leading-7">Get your API key and have a pull request in minutes.</p></header><div class="mx-auto text-center"><a href="/signup"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium text-sm ring-offset-background transition-all duration-150 ease-in-out disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 relative rounded-md border border-transparent bg-linear-to-b bg-primary from-[#2c2c30] to-[#1d1d20] text-primary-foreground shadow-inner before:pointer-events-none before:absolute before:inset-0 before:rounded-md before:shadow-[0px_2px_0.4px_0px_rgba(255,255,255,0.16)_inset] hover:bg-[#1f1f1f] hover:opacity-90 hover:shadow-none focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-neutral-900 focus-visible:ring-offset-1 dark:bg-linear-to-b dark:from-white dark:to-neutral-100 dark:text-primary-foreground dark:hover:bg-white h-10 px-4 py-2">Start building now →</button></a></div></div></section></section><!--$--><!--/$--></main><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","name":"Logo.dev","url":"https://www.logo.dev/","logo":"https://www.logo.dev/logodev-icon.svg","description":"Logo.dev gives developers instant access to millions of verified company logos via a fast, reliable CDN and API.","sameAs":["https://x.com/logodotdev","https://www.linkedin.com/company/logodotdev/","https://github.com/logo-dev"],"dateModified":"2026-05-30T20:15:14.011Z"},{"@type":"WebSite","name":"Lo